# ── General ──────────────────────────────────────────────
LJIT_ENV=local
LJIT_LOG_LEVEL=INFO

# ── Database / Storage ───────────────────────────────────
LJIT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lattice_jit
LJIT_REDIS_URL=redis://localhost:6379/0
LJIT_CACHE_TTL_SECONDS=3600
LJIT_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# ── Celery / Worker ──────────────────────────────────────
LJIT_CELERY_BROKER_URL=redis://localhost:6379/1
LJIT_CELERY_RESULT_BACKEND=redis://localhost:6379/2
LJIT_CELERY_EAGER=true
LJIT_CELERY_TASK_MAX_RETRIES=3
LJIT_CELERY_TASK_SOFT_TIME_LIMIT=600
LJIT_CELERY_DLQ_ENABLED=true

# ── Model / LLM ──────────────────────────────────────────
LJIT_MODEL_PROVIDER=stub
# LJIT_MODEL_PROVIDER=litellm
# LJIT_LITELLM_MODEL=deepseek/deepseek-chat
# LJIT_LITELLM_TEMPERATURE=0.0
# LJIT_LITELLM_MAX_OUTPUT_TOKENS=4096
# LJIT_LITELLM_DEEPSEEK_API_KEY=sk-...
# LJIT_LITELLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LJIT_LITELLM_PROMPT_CACHING_ENABLED=false

# ── Embedding Router ─────────────────────────────────────
# LJIT_EMBEDDING_ENABLED=true
# LJIT_EMBEDDING_MODEL=minishlab/potion-base-8M

# ── Policy / OPA ─────────────────────────────────────────
LJIT_POLICY_MODE=inline
# LJIT_POLICY_MODE=opa_http
# LJIT_POLICY_OPA_URL=http://localhost:8181
# LJIT_POLICY_OPA_PATH=/v1/data/lattice_jit/policy
# LJIT_POLICY_OPA_TIMEOUT_SECONDS=2.0
# LJIT_POLICY_OPA_FAIL_CLOSED=false

# ── Query / Context ──────────────────────────────────────
LJIT_MAX_CONTEXT_TOKENS=12000
LJIT_CONTEXT_ITEM_CHAR_BUDGET=2400
LJIT_ROUTER_MODE=baseline
LJIT_ROUTER_MAX_NODES=8

# ── Authentication ───────────────────────────────────────
# LJIT_AUTH_ENABLED=true
# LJIT_AUTH_API_KEYS=key1=00000000-0000-0000-0000-000000000001,key2=00000000-0000-0000-0000-000000000002

# ── Rate Limiting ────────────────────────────────────────
# LJIT_RATE_LIMIT_ENABLED=true
# LJIT_RATE_LIMIT_MAX_PER_MINUTE=60
# LJIT_RATE_LIMIT_INGEST_MAX_PER_MINUTE=10
# LJIT_RATE_LIMIT_EXPORT_MAX_PER_MINUTE=5

# ── Load Shedding ────────────────────────────────────────
# LJIT_LOAD_SHEDDING_ENABLED=true
# LJIT_LOAD_SHEDDING_MAX_ITEMS_PER_MINUTE=100
# LJIT_LOAD_SHEDDING_WINDOW_SECONDS=60

# ── SharePoint Connector ─────────────────────────────────
# LJIT_SHAREPOINT_CLIENT_ID=...
# LJIT_SHAREPOINT_CLIENT_SECRET=...
# LJIT_SHAREPOINT_AZURE_TENANT_ID=...

# ── Confluence Connector ─────────────────────────────────
# LJIT_CONFLUENCE_URL=https://your-domain.atlassian.net
# LJIT_CONFLUENCE_USERNAME=your-email@example.com
# LJIT_CONFLUENCE_API_TOKEN=...
